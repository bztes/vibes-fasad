# Directory for the database (app.db) and uploaded photos (scenes and masks folders)
DATA_DIR=./data

# Only for plain http: URL the app is opened with, otherwise form submissions fail with 403.
# Leave it unset behind an https reverse proxy like Caddy.
# ORIGIN=http://server:3000

# Recovery e-mail: secret key for the address hashes (openssl rand -base64 32); off when empty.
# Changing it breaks the addresses saved so far.
EMAIL_PEPPER=""

# Mail server, e.g. smtps://smtp.example.com; recovery e-mails are logged when empty
SMTP_URL=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_MAIL_FROM="Fasad <noreply@example.com>"

# Largest request body (adapter-node); photos are uploaded through forms
BODY_SIZE_LIMIT=20M
