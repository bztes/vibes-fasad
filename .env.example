# Drizzle
DATABASE_URL=file:data/local.db

# Data directory; uploaded photos go in its scenes and masks folders
DIR=./data

# Recovery e-mail: secret key for the address hashes (openssl rand -base64 32); off when empty.
# Changing it breaks the addresses saved so far.
EMAIL_PEPPER=""

# Mail server, e.g. smtps://smtp.example.com; recovery e-mails are logged when empty
SMTP_URL=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_MAIL_FROM="Fasad <noreply@example.com>"

# Largest request body (adapter-node); photos are uploaded through forms
BODY_SIZE_LIMIT=20M
